import { LineEdit, ComboBox, Slider, Switch, ScrollView, ProgressIndicator, TextEdit } from "std-widgets.slint";

export struct AccountItem {
    name: string,
    sub: string,
    ms: bool,
    initial: string,
}

global Pal {
    out property <color> bg: #0c0e13;
    out property <color> side: #10131a;
    out property <color> surface: #151925;
    out property <color> surface2: #1b2031;
    out property <color> border: #272d42;
    out property <color> text: #e9ebf5;
    out property <color> muted: #8890a8;
    out property <color> accent: #8b7bff;
    out property <color> accent2: #3fc8f2;
    out property <color> danger: #ff6b81;
    out property <color> ok: #4ade80;
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    border-radius: 10px;
    opacity: enabled ? 1.0 : 0.45;
    background: primary ? @linear-gradient(90deg, Pal.accent, Pal.accent2)
        : (ta.has-hover && enabled ? Pal.border : Pal.surface2);
    border-width: primary ? 0px : 1px;
    border-color: danger ? Pal.danger : Pal.border;
    animate background { duration: 120ms; }
    Text {
        text: root.label;
        color: primary ? #0b0d12 : (danger ? Pal.danger : Pal.text);
        font-size: 14px;
        font-weight: primary ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Nav inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    height: 44px;
    border-radius: 10px;
    background: active ? Pal.surface2 : (ta.has-hover ? #151a26 : transparent);
    animate background { duration: 120ms; }
    Rectangle {
        x: 0; width: 3px; height: 22px; border-radius: 2px;
        background: active ? Pal.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 18px; spacing: 12px; alignment: start;
        Text { text: root.glyph; color: active ? Pal.accent : Pal.muted; font-size: 18px; vertical-alignment: center; }
        Text { text: root.label; color: active ? Pal.text : Pal.muted; font-size: 15px; font-weight: active ? 600 : 500; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    background: Pal.surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: Pal.border;
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <string> value;
    in property <bool> password: false;
    spacing: 6px;
    Text { text: root.label; color: Pal.muted; font-size: 12px; font-weight: 600; }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.hint;
        input-type: root.password ? InputType.password : InputType.text;
    }
}

component Title inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 4px;
    Text { text: root.title; color: Pal.text; font-size: 26px; font-weight: 800; }
    Text { text: root.sub; color: Pal.muted; font-size: 13px; wrap: word-wrap; }
}

component Seg inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    border-radius: 9px;
    background: active ? Pal.accent : transparent;
    animate background { duration: 140ms; }
    Text {
        text: root.label; font-size: 14px; font-weight: 600;
        color: active ? #0b0d12 : Pal.muted;
        horizontal-alignment: center; vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "ezzmc launcher";
    background: Pal.bg;
    min-width: 900px;
    min-height: 620px;
    preferred-width: 1060px;
    preferred-height: 680px;
    default-font-size: 14px;

    in-out property <int> page: 0;
    in-out property <[AccountItem]> accounts;
    in-out property <int> selected: 0;
    in-out property <int> target: 0;
    in-out property <[string]> versions;
    in-out property <string> version;
    in-out property <string> server;
    in property <string> status: "Готово";
    in property <float> progress: 0;
    in property <bool> busy: false;
    in property <bool> running: false;
    in property <string> log;
    in property <string> toast;

    // настройки
    in-out property <string> game_dir;
    in-out property <string> client_path;
    in-out property <string> client_dir;
    in-out property <string> java_path;
    in property <[string]> javas;
    in-out property <float> ram_min: 1024;
    in-out property <float> ram_max: 4096;
    in-out property <string> jvm_args;
    in-out property <string> game_args;
    in-out property <string> msa_client_id;
    in-out property <bool> close_on_launch;
    in-out property <bool> fullscreen;

    // добавление аккаунта
    in-out property <string> new_nick;
    in property <bool> ms_open: false;
    in property <string> ms_code;
    in property <string> ms_url;
    in property <string> ms_status;

    callback play();
    callback play_both();
    callback stop();
    callback save_settings();
    callback add_offline(string);
    callback add_ms();
    callback cancel_ms();
    callback select_account(int);
    callback remove_account(int);
    callback open_url(string);
    callback copy_text(string);
    callback find_javas();
    callback refresh_versions();
    callback clear_log();

    function sel_name() -> string {
        root.selected >= 0 && root.selected < root.accounts.length ? root.accounts[root.selected].name : "—"
    }
    function sel_sub() -> string {
        root.selected >= 0 && root.selected < root.accounts.length ? root.accounts[root.selected].sub : ""
    }

    HorizontalLayout {
        // ---------- боковая панель ----------
        Rectangle {
            width: 236px;
            background: Pal.side;
            VerticalLayout {
                padding: 18px; spacing: 6px;
                HorizontalLayout {
                    spacing: 12px; padding-bottom: 22px; padding-left: 4px;
                    Rectangle {
                        width: 42px; height: 42px; border-radius: 13px;
                        background: @linear-gradient(135deg, Pal.accent, Pal.accent2);
                        Text { text: "e"; color: #0b0d12; font-size: 26px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "ezzmc"; color: Pal.text; font-size: 20px; font-weight: 800; }
                        Text { text: "Rust · приватный клиент"; color: Pal.muted; font-size: 11px; }
                    }
                }
                Nav { label: "Играть"; glyph: "▶"; active: root.page == 0; clicked => { root.page = 0; } }
                Nav { label: "Аккаунты"; glyph: "☺"; active: root.page == 1; clicked => { root.page = 1; } }
                Nav { label: "Настройки"; glyph: "⚙"; active: root.page == 2; clicked => { root.page = 2; } }
                Nav { label: "Журнал"; glyph: "≡"; active: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 62px; border-radius: 14px; background: Pal.surface; border-width: 1px; border-color: Pal.border;
                    TouchArea { clicked => { root.page = 1; } }
                    HorizontalLayout {
                        padding: 10px; spacing: 10px;
                        Rectangle {
                            width: 40px; height: 40px; border-radius: 20px;
                            background: root.selected >= 0 && root.selected < root.accounts.length && root.accounts[root.selected].ms ? Pal.accent2 : Pal.accent;
                            Text { text: root.selected >= 0 && root.selected < root.accounts.length ? root.accounts[root.selected].initial : "?"; color: #0b0d12; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.sel_name(); color: Pal.text; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: root.sel_sub(); color: Pal.muted; font-size: 11px; }
                        }
                    }
                }
            }
        }

        // ---------- содержимое ----------
        Rectangle {
            horizontal-stretch: 1;

            // Играть
            if root.page == 0: VerticalLayout {
                padding: 32px; spacing: 20px;
                Title { title: "Играть"; sub: "Выбери, чем запускать: клиент ezzmc на Rust или ванильная Java."; }
                Card {
                    VerticalLayout {
                        padding: 24px; spacing: 18px;
                        Text { text: "ЗАПУСК"; color: Pal.muted; font-size: 11px; font-weight: 700; }
                        Rectangle {
                            height: 46px; border-radius: 12px; background: Pal.bg; border-width: 1px; border-color: Pal.border;
                            HorizontalLayout {
                                padding: 4px; spacing: 4px;
                                Seg { label: "ezzmc (Rust)"; active: root.target == 0; clicked => { root.target = 0; } }
                                Seg { label: "Ванильная Java"; active: root.target == 1; clicked => { root.target = 1; } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                width: 240px; spacing: 6px;
                                Text { text: root.target == 1 ? "Версия" : "Версия ванили (для «Оба»)"; color: Pal.muted; font-size: 12px; font-weight: 600; }
                                ComboBox { model: root.versions; current-value <=> root.version; }
                            }
                            Field { label: "Сервер (необязательно)"; hint: "127.0.0.1:25565"; value <=> root.server; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Btn {
                                primary: true; height: 54px; horizontal-stretch: 1;
                                label: root.running ? "Игра запущена" : (root.busy ? "Подготовка…" : "▶  ИГРАТЬ");
                                enabled: !root.busy && !root.running;
                                clicked => { root.play(); }
                            }
                            Btn {
                                width: 190px; height: 54px; label: "▶  ОБА (ezzmc + ваниль)";
                                enabled: !root.busy && !root.running;
                                clicked => { root.play_both(); }
                            }
                            if root.running: Btn { width: 130px; height: 54px; label: "Остановить"; danger: true; clicked => { root.stop(); } }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            ProgressIndicator { progress: root.progress; visible: root.busy; }
                            Text { text: root.status; color: Pal.muted; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
                Text {
                    text: root.target == 0 ? "ezzmc берёт ресурсы из папки игры (Настройки → Игра). Аккаунт Microsoft даёт онлайн-вход на серверы с online-mode=true." : "Недостающие файлы версии (клиент, библиотеки, ассеты) докачаются автоматически.";
                    color: Pal.muted; font-size: 12px; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
            }

            // Аккаунты
            if root.page == 1: VerticalLayout {
                padding: 32px; spacing: 18px;
                Title { title: "Аккаунты"; sub: "Offline — любой ник. Microsoft — лицензия, нужна для серверов с online-mode."; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        for a[i] in root.accounts: Rectangle {
                            height: 66px; border-radius: 14px;
                            background: i == root.selected ? Pal.surface2 : Pal.surface;
                            border-width: 1px; border-color: i == root.selected ? Pal.accent : Pal.border;
                            animate background { duration: 120ms; }
                            TouchArea { clicked => { root.select_account(i); } }
                            HorizontalLayout {
                                padding: 12px; spacing: 14px;
                                Rectangle {
                                    width: 42px; height: 42px; border-radius: 21px;
                                    background: a.ms ? Pal.accent2 : Pal.accent;
                                    Text { text: a.initial; color: #0b0d12; font-size: 19px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text { text: a.name; color: Pal.text; font-size: 15px; font-weight: 700; }
                                    Text { text: a.sub; color: Pal.muted; font-size: 12px; }
                                }
                                Text { text: i == root.selected ? "● выбран" : ""; color: Pal.ok; font-size: 12px; vertical-alignment: center; }
                                Btn { width: 40px; height: 36px; label: "✕"; danger: true; y: 0px; clicked => { root.remove_account(i); } }
                            }
                        }
                    }
                }
                Card {
                    height: 132px;
                    HorizontalLayout {
                        padding: 20px; spacing: 16px;
                        VerticalLayout {
                            spacing: 8px; horizontal-stretch: 1;
                            Text { text: "OFFLINE-АККАУНТ"; color: Pal.muted; font-size: 11px; font-weight: 700; }
                            LineEdit { text <=> root.new_nick; placeholder-text: "Ник (3–16: буквы, цифры, _)"; accepted(t) => { root.add_offline(t); } }
                            Btn { label: "Добавить"; clicked => { root.add_offline(root.new_nick); } }
                        }
                        Rectangle { width: 1px; background: Pal.border; }
                        VerticalLayout {
                            spacing: 8px; horizontal-stretch: 1;
                            Text { text: "ЛИЦЕНЗИЯ"; color: Pal.muted; font-size: 11px; font-weight: 700; }
                            Text { text: "Вход через Microsoft по коду (device code)."; color: Pal.muted; font-size: 12px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                            Btn { primary: true; label: "Войти через Microsoft"; clicked => { root.add_ms(); } }
                        }
                    }
                }
            }

            // Настройки
            if root.page == 2: VerticalLayout {
                padding: 32px; spacing: 14px;
                Title { title: "Настройки"; sub: "Папка игры, Java, память и аргументы."; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 16px; padding-right: 14px;
                        Card {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                Text { text: "ИГРА"; color: Pal.muted; font-size: 11px; font-weight: 700; }
                                Field { label: "Папка игры (.minecraft)"; value <=> root.game_dir; }
                                Field { label: "Клиент ezzmc-client (пусто = найти автоматически)"; value <=> root.client_path; }
                                Field { label: "Рабочая папка ezzmc (options.txt, servers.dat)"; value <=> root.client_dir; }
                                HorizontalLayout {
                                    spacing: 30px;
                                    HorizontalLayout { spacing: 10px; Switch { checked <=> root.fullscreen; } Text { text: "Полный экран"; color: Pal.text; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 10px; Switch { checked <=> root.close_on_launch; } Text { text: "Закрывать лаунчер при старте"; color: Pal.text; vertical-alignment: center; } }
                                }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                HorizontalLayout {
                                    Text { text: "JAVA"; color: Pal.muted; font-size: 11px; font-weight: 700; horizontal-stretch: 1; }
                                    Btn { width: 150px; height: 30px; label: "Найти Java"; clicked => { root.find_javas(); } }
                                }
                                Field { label: "Путь к java (пусто = подобрать автоматически)"; value <=> root.java_path; }
                                if root.javas.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Найденные установки — выбери:"; color: Pal.muted; font-size: 12px; }
                                    ComboBox { model: root.javas; selected(v) => { root.java_path = v; } }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        Text { text: "Минимум памяти"; color: Pal.muted; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                                        Text { text: Math.round(root.ram_min / 256) * 256 + " МБ"; color: Pal.text; font-size: 12px; font-weight: 700; }
                                    }
                                    Slider { minimum: 256; maximum: 32768; value <=> root.ram_min; }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        Text { text: "Максимум памяти"; color: Pal.muted; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                                        Text { text: Math.round(root.ram_max / 256) * 256 + " МБ"; color: Pal.text; font-size: 12px; font-weight: 700; }
                                    }
                                    Slider { minimum: 512; maximum: 32768; value <=> root.ram_max; }
                                }
                                Field { label: "JVM-аргументы"; value <=> root.jvm_args; }
                                Field { label: "Аргументы игры"; value <=> root.game_args; }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                Text { text: "MICROSOFT"; color: Pal.muted; font-size: 11px; font-weight: 700; }
                                Field { label: "Azure client_id (приложение с доступом к Minecraft API)"; value <=> root.msa_client_id; }
                                Text { text: "Регистрация: portal.azure.com → App registrations → «Personal accounts», public client; доступ к API одобряет Mojang (aka.ms/AppRegInfo)."; color: Pal.muted; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Btn { primary: true; width: 200px; label: "Сохранить"; clicked => { root.save_settings(); } }
                }
            }

            // Журнал
            if root.page == 3: VerticalLayout {
                padding: 32px; spacing: 14px;
                HorizontalLayout {
                    Title { title: "Журнал"; sub: "Вывод игры и действия лаунчера."; horizontal-stretch: 1; }
                    Btn { width: 120px; height: 34px; label: "Очистить"; clicked => { root.clear_log(); } }
                }
                TextEdit { read-only: true; text: root.log; font-size: 12px; vertical-stretch: 1; wrap: no-wrap; }
            }

            // тост
            if root.toast != "": Rectangle {
                y: parent.height - 70px; x: (parent.width - self.width) / 2;
                width: min(parent.width - 40px, 560px); height: 46px; border-radius: 12px;
                background: Pal.surface2; border-width: 1px; border-color: Pal.accent;
                Text { text: root.toast; color: Pal.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
        }
    }

    // ---------- окно входа Microsoft ----------
    if root.ms_open: Rectangle {
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: 460px; height: 330px; border-radius: 20px;
            background: Pal.surface; border-width: 1px; border-color: Pal.border;
            VerticalLayout {
                padding: 28px; spacing: 14px;
                Text { text: "Вход через Microsoft"; color: Pal.text; font-size: 20px; font-weight: 800; }
                Text { text: "Открой страницу и введи код:"; color: Pal.muted; font-size: 13px; }
                Rectangle {
                    height: 70px; border-radius: 14px; background: Pal.bg; border-width: 1px; border-color: Pal.accent;
                    Text { text: root.ms_code == "" ? "…" : root.ms_code; color: Pal.accent2; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: root.ms_url; color: Pal.muted; font-size: 12px; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 10px;
                    Btn { label: "Открыть страницу"; primary: true; horizontal-stretch: 1; enabled: root.ms_code != ""; clicked => { root.open_url(root.ms_url); } }
                    Btn { label: "Копировать код"; horizontal-stretch: 1; enabled: root.ms_code != ""; clicked => { root.copy_text(root.ms_code); } }
                }
                Text { text: root.ms_status; color: Pal.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle { vertical-stretch: 1; }
                Btn { label: "Отмена"; clicked => { root.cancel_ms(); } }
            }
        }
    }
}
